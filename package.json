{
  "name": "anylist-mcp",
  "version": "1.7.3",
  "description": "MCP server for AnyList shopping list integration",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:client": "node test/anylist-client/index.js",
    "test:integration": "node test/integration.js",
    "test:release": "python -m unittest discover -s test -p production_release_test.py",
    "pack": "mcpb pack",
    "start:http": "node src/http/index.js",
    "dev:http": "node --watch src/http/index.js",
    "test": "node --test test/*.test.js test/tools/*.test.js"
  },
  "keywords": [
    "mcp",
    "anylist",
    "shopping",
    "list"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.2",
    "express-session": "^1.19.0",
    "form-data": "3.0.5",
    "google-auth-library": "^10.6.2",
    "got": "11.8.6",
    "protobufjs": "8.7.2",
    "reconnecting-websocket": "4.4.0",
    "uuid": "file:compat/uuid",
    "ws": "7.5.13"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
